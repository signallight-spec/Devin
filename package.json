{
  "name": "study-habit-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist --persist-to .wrangler/state",
    "db:migrate": "wrangler d1 migrations apply study-habit --local --persist-to .wrangler/state",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260910.1",
    "@eslint/js": "9.35.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "6.0.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "5.0.1",
    "wrangler": "4.131.0"
  }
}
